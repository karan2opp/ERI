# Backend API (the Vite dev server also proxies /api to localhost:5000)
VITE_API_URL=http://localhost:5000/api/v1

# Clerk publishable key (same Clerk app as the server)
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: CARTO basemaps key, used only if Google map tiles aren't available
VITE_CARTO_API_KEY=

# Optional: Mapbox token for walking routes (straight lines are used without it)
VITE_MAPBOX_TOKEN=
