{
  "name": "plantree-server",
  "version": "1.0.0",
  "description": "PlanTree Express Backend with Drizzle ORM, Clerk Auth & Cloudinary",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node --transpile-only src/scripts/seedDemo.ts"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.7",
    "@clerk/express": "^1.3.0",
    "cloudinary": "^2.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.4",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.1",
    "multer": "^1.4.5-lts.1",
    "postgres": "^3.4.5",
    "socket.io": "^4.8.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "drizzle-kit": "^0.30.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
