PORT=5000
NODE_ENV=development

# PostgreSQL (docker compose at the repo root exposes it on 5555)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5555/plantree_db"
# Neon: use the POOLED address for the app (host contains "-pooler"), with ?sslmode=require, e.g.
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# and the DIRECT address (no "-pooler") for schema changes (npm run db:push):
#   DATABASE_URL_DIRECT="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Comma-separated browser origins allowed by CORS
CLIENT_ORIGIN="http://localhost:5173"

# Number of reverse-proxy hops in front of the server (for rate limiting by client IP). Leave unset when not behind a proxy.
# TRUST_PROXY=1

# Clerk (required: it is the only way users authenticate)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary image storage (required for photos: the phone uploads straight to Cloudinary with a signature from the server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI checks that a new tree's photo really is a tree or plant (optional: without a key, every new tree waits for an admin to review it)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Drive emails through Resend (https://resend.com). Optional: without these nothing is emailed.
RESEND_API_KEY=
# The sender has to be on a domain you verified in Resend, e.g. "Earth Revival Initiative <drives@yourdomain.com>"
EMAIL_FROM=
# The app's public address, used for links in emails and notifications (defaults to the first CLIENT_ORIGIN)
# APP_URL=https://yourdomain.com

# Web push notifications. Optional: make keys with  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact the push services can reach
VAPID_SUBJECT=mailto:you@yourdomain.com

# Google Maps (optional; falls back to OpenStreetMap)
GOOGLE_MAP_API=

# To make someone an admin, run: UPDATE users SET role = 'ADMIN' WHERE email = 'you@example.com';
