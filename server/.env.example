PORT=5000
NODE_ENV=development

# PostgreSQL (docker compose at the repo root exposes it on 5555)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5555/plantree_db"

# Comma-separated browser origins allowed by CORS
CLIENT_ORIGIN="http://localhost:5173"

# Number of reverse-proxy hops in front of the server (for rate limiting by client IP). Leave unset when not behind a proxy.
# TRUST_PROXY=1

# Clerk (required: it is the only way users authenticate)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary image storage (optional; placeholder images are used when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (optional; falls back to OpenStreetMap)
GOOGLE_MAP_API=

# To make someone an admin, run: UPDATE users SET role = 'ADMIN' WHERE email = 'you@example.com';
